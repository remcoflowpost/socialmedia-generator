# Kopieer naar .env en vul in. .env staat in .gitignore en komt nooit in git.
# Open punt (flow-guidelines): verhouding .env tot de Rez-omgeving is niet vastgelegd.
# Deze tool draait in docker buiten de pipeline, daarom .env naast docker-compose.yml.

ENVIRONMENT=production
POSTGRES_PASSWORD=verander-mij

# Lange willekeurige string, bijv.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Publieke URL van de web-app, met https. Google OAuth eist een domein met publieke TLD.
PUBLIC_URL=https://social.example.nl
WEB_PORT=8080

# Allowlist: e-mail=rol, gescheiden door komma's. Rollen: admin, editor.
ALLOWLIST=remco@example.nl=admin,editor1@example.nl=editor

# Google Workspace OAuth (Google Cloud Console, OAuth-client type "Web application").
# Redirect-URI: ${PUBLIC_URL}/api/auth/callback
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Remotion Company License (Automators). Leeg = evaluatie, renders worden niet geteld.
REMOTION_LICENSE_KEY=
RENDER_CONCURRENCY=2

# Alleen voor de NAS-variant van het storage-volume in docker-compose.yml.
NAS_USER=
NAS_PASSWORD=

# Publiceren (docs/publiceren.md). 32 bytes, base64: openssl rand -base64 32
# Kwijt = alle gekoppelde accounts opnieuw koppelen. Bewaar hem in de wachtwoordkluis.
TOKEN_ENCRYPTION_KEY=

# Meta-app (developers.facebook.com, type Business). Redirect-URI:
# ${PUBLIC_URL}/api/publishing/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Sandbox-netwerk om te testen zonder Meta. Nooit true in productie.
ALLOW_SANDBOX_PROVIDER=false
